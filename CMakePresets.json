{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "COLONY_SANITIZER": "none"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug Development",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release Build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "ASan + UBSan Build",
      "inherits": "dev",
      "cacheVariables": {
        "COLONY_SANITIZER": "asan-ubsan"
      }
    },
    {
      "name": "tsan",
      "displayName": "TSan Build",
      "inherits": "dev",
      "cacheVariables": {
        "COLONY_SANITIZER": "tsan"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "tsan", "configurePreset": "tsan" }
  ],
  "testPresets": [
    {
      "name": "base-test",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "dev", "configurePreset": "dev", "inherits": "base-test" },
    { "name": "release", "configurePreset": "release", "inherits": "base-test" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan", "inherits": "base-test" },
    { "name": "tsan", "configurePreset": "tsan", "inherits": "base-test" }
  ]
}