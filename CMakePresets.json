{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug Development",
      "binaryDir": "${sourceDir}/build/dev",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "COLONY_SANITIZER": "none"
      }
    },
    {
      "name": "release",
      "displayName": "Release Build",
      "binaryDir": "${sourceDir}/build/release",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "COLONY_SANITIZER": "none"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "ASan + UBSan Build",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "COLONY_SANITIZER": "asan-ubsan"
      }
    },
    {
      "name": "tsan",
      "displayName": "TSan Build",
      "binaryDir": "${sourceDir}/build/tsan",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "COLONY_SANITIZER": "tsan"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "tsan", "configurePreset": "tsan" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } }
  ]
}